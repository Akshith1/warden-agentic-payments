<!-- Phase 11b-2: the "Invoice intake" product's limits, per subscription: 10 calls a minute and
     500 a day. A quota can only be set on a product; the product's policy runs before the API's,
     so a flood of bad tokens is cut off here, cheaply. -->
<policies>
  <inbound>
    <base />
    <rate-limit calls="10" renewal-period="60" />
    <quota calls="500" renewal-period="86400" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
