<!-- Phase 11b-2: the Warden invoices API in API Management. __TENANT__ and __APP__ are filled in
     by main.bicep. The rate limit and quota come first, from the product (apim-product-policy.xml);
     then the token: signed by Entra ID for the Warden app, with the submitter role; then the
     front-door key the backend checks, from a secret named value. The backend checks the token
     again itself. -->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="__TENANT__" header-name="Authorization" failed-validation-httpcode="401"
                             failed-validation-error-message="Send an Entra ID token for Warden with the submitter role">
      <audiences>
        <audience>__APP__</audience>
        <audience>api://__APP__</audience>
      </audiences>
      <required-claims>
        <claim name="roles" match="any">
          <value>submitter</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>
    <set-header name="X-Warden-Entry" exists-action="override">
      <value>{{warden-entry-key}}</value>
    </set-header>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
