{
  "uid": "warden",
  "title": "Warden",
  "tags": [
    "warden"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Run segments by outcome",
      "description": "How each stretch of a run ended, over the dashboard's time range: settled, waiting for a person (pending_human), rejected, blocked, failed or stopped by the kill switch.",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(warden_runs_total[$__range]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Why invoices went to a person",
      "description": "Escalation reasons from the risk step, grouped by kind.",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (increase(warden_escalations_total[$__range]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Policy decisions",
      "description": "Cedar decisions, for agents and for people.",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (decision, principal) (increase(warden_policy_decisions_total[$__range]))",
          "legendFormat": "{{principal}} {{decision}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Where the time goes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 5,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Step latency, 95th percentile",
      "description": "Time per graph step. A slow model shows here first.",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, step) (rate(warden_agent_duration_seconds_bucket{outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "{{step}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Model call latency by agent, 95th percentile",
      "description": "Time per call to the model gateway.",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(warden_llm_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Service latency, 95th percentile",
      "description": "Every instrumented service's HTTP requests: backend, policy, ledger, control plane, data quality.",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Model tokens by agent",
      "description": "Input and output tokens per agent over the time range. Budgets are on the console's Governance page.",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent, kind) (increase(warden_llm_tokens_total[$__range]))",
          "legendFormat": "{{agent}} {{kind}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Are the agents consistent?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 10,
      "panels": []
    },
    {
      "type": "table",
      "title": "Risk scores per vendor",
      "description": "Every risk score each vendor got in the time range, from the step logs. A wide spread on similar invoices is worth a consistency check (see the README).",
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({service_name=\"warden-backend\"} | json | __error__=\"\" | step=\"risk_scoring\" | unwrap risk_score [$__range]) by (vendor)",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "min_over_time({service_name=\"warden-backend\"} | json | __error__=\"\" | step=\"risk_scoring\" | unwrap risk_score [$__range]) by (vendor)",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (vendor) (count_over_time({service_name=\"warden-backend\"} | json | __error__=\"\" | step=\"risk_scoring\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Highest",
              "Value #B": "Lowest",
              "Value #C": "Runs scored",
              "vendor": "Vendor"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Consistency checks",
      "description": "The spread (highest minus lowest) when the same invoice was scored again and again with python -m app.consistency. Above 0.2 for risk means the model, not the invoice, is moving.",
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (vendor, agent, field) (last_over_time(warden_consistency_spread[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Spread",
              "vendor": "Vendor",
              "agent": "Agent",
              "field": "Measured"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Risk score distribution",
      "description": "How many risk scores fell in each band over the time range.",
      "id": 13,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(warden_risk_score_bucket[$__range]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "le"
              }
            ]
          }
        }
      ],
      "options": {
        "xField": "le"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Recent runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "id": 14,
      "panels": []
    },
    {
      "type": "table",
      "title": "Run traces",
      "description": "One trace per stretch of a run. Open one to see every step, model call and service call in order, with timings.",
      "id": 15,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "refId": "A",
          "limit": 30,
          "tableType": "traces",
          "query": "{resource.service.name=\"warden-backend\" && name=~\"invoice run.*\"}"
        }
      ],
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      }
    },
    {
      "type": "logs",
      "title": "Step log",
      "description": "Each step's trail entry as it happened, the same facts the audit log holds.",
      "id": 16,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"warden-backend\"}",
          "queryType": "range",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
