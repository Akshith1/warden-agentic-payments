# Warden local environment. Copy to .env (gitignored), add the two API keys, then fill
# every empty secret below with a fresh random value:
#     python infra/scripts/fill-secrets.py
# Never commit .env. This example file is public, so it holds no secrets of its own.

# --- The only two values you must supply ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Postgres ---
POSTGRES_PASSWORD=
PGPASS_WARDEN_LEDGER=
PGPASS_WARDEN_BACKEND=
PGPASS_MLFLOW=
PGPASS_LITELLM=

# --- LLM gateway ---
# Admin key for the gateway only. Since phase 8 each agent has its own key, generated into a
# Docker volume (agent-keys); no service but LiteLLM holds this one.
LITELLM_MASTER_KEY=

# --- Ledger keys (two on purpose: read-only lookup vs. write) ---
LEDGER_WRITE_KEY=
VENDOR_LOOKUP_KEY=
OPENING_CASH=250000.00

# --- Agent thresholds ---
ROUTINE_AMOUNT_THRESHOLD=5000
CONFIDENCE_THRESHOLD=0.75
SETTLEMENT_HOLD_SECONDS=20
# Ledger currency: a document with no printed currency is taken to be in it; others escalate.
LEDGER_CURRENCY=MYR
# Settled payments a vendor needs before an invoice can be auto-approved.
MIN_PRIOR_PAYMENTS=2

# --- Prompt promotion gate (phase 2) ---
EVAL_SAMPLE_SIZE=40
PROMOTION_THRESHOLD=0.80
# Every field (vendor, date, total) must also reach this; see warden-backend/app/evalgate.py.
FIELD_FLOOR=0.75

# --- Data loader ---
SROIE_TRAIN_LIMIT=200
SROIE_TEST_LIMIT=60
CORD_TRAIN_LIMIT=100
CORD_TEST_LIMIT=40
USASPENDING_AGENCY=Department of Health and Human Services
USASPENDING_FISCAL_YEAR=2025
USASPENDING_PAGES=3

# Phase 6: Keycloak's admin console (http://localhost:8180/admin). Any long random value.
KEYCLOAK_ADMIN_PASSWORD=
