# Warden local environment. Copy to .env (gitignored) and fill in the two API keys.
# Every other value is a random local-only secret, safe to keep for a laptop build.
# Regenerate any of them with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- The only two values you must supply ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Postgres ---
