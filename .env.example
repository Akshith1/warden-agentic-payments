PGPASS_LITELLM=fjXkuwnkR-d3N_DFC0Cqd0nfLy39USz9mf_tq-5Nb2c

# --- LLM gateway ---
# Phase 1: the backend uses the master key. Phase 8 replaces it with one budget-capped key per agent.
LITELLM_MASTER_KEY=sk-Tt8WHjkPf3MbuAhi9ZHuhDbUN4bOzCMSD1FVwaEbsI4

# --- Ledger keys (two on purpose: read-only lookup vs. write) ---
LEDGER_WRITE_KEY=aKjIiHrIi04JVWYtD86PLxjc68wuUQPtu0-KvtPelwQ
VENDOR_LOOKUP_KEY=K79ucbWMTKuAG43eBBLrMGsFmwdJzDCHBYkVM0RZgUo
OPENING_CASH=250000.00

# --- Agent thresholds ---
ROUTINE_AMOUNT_THRESHOLD=5000
CONFIDENCE_THRESHOLD=0.75
SETTLEMENT_HOLD_SECONDS=20
# Ledger currency: a document with no printed currency is taken to be in it; others escalate.
LEDGER_CURRENCY=MYR
# Settled payments a vendor needs before an invoice can be auto-approved.
MIN_PRIOR_PAYMENTS=2

# --- Prompt promotion gate (phase 2) ---
EVAL_SAMPLE_SIZE=40
PROMOTION_THRESHOLD=0.80
# Every field (vendor, date, total) must also reach this; see warden-backend/app/evalgate.py.
FIELD_FLOOR=0.75

# --- Data loader ---
SROIE_TRAIN_LIMIT=200
SROIE_TEST_LIMIT=60
CORD_TRAIN_LIMIT=100
CORD_TEST_LIMIT=40
USASPENDING_AGENCY=Department of Health and Human Services
USASPENDING_FISCAL_YEAR=2025
USASPENDING_PAGES=3
